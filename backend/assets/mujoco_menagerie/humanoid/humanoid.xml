<?xml version="1.0" ?>
<mujoco model="humanoid">
  <compiler angle="degree" inertiafromgeom="true"/>
  <default>
    <joint armature="1" damping="1" limited="true"/>
    <geom conaffinity="1" condim="1" contype="1" density="5" friction="1 0.5 0.5" margin="0.01" rgba="0.8 0.6 0.4 1"/>
  </default>

  <asset>
    <texture builtin="gradient" height="100" rgb1="1 1 1" rgb2="0 0 0" type="2d" width="100"/>
    <material name="geom" reflectance="0.1" specular="0.5" texture="texture"/>
  </asset>

  <worldbody>
    <body name="torso" pos="0 0 1.4">
      <camera name="track" mode="trackcom" pos="0 -4 1.5" xyaxes="1 0 0 0 0.5 1"/>
      <joint axis="1 0 0" name="abdomen_x" pos="0 0 0" range="-45 45" type="hinge"/>
      <joint axis="0 1 0" name="abdomen_y" pos="0 0 0" range="-45 45" type="hinge"/>
      <joint axis="0 0 1" name="abdomen_z" pos="0 0 0" range="-45 45" type="hinge"/>
      <geom name="torso_geom" pos="0 0 0" size="0.07" type="sphere"/>
      <geom name="upper_torso_geom" pos="0 0 0.15" size="0.06 0.15" type="capsule"/>

      <body name="right_thigh" pos="0 -0.1 0">
        <joint axis="0 1 0" name="right_hip_y" pos="0 0 0" range="-120 120" type="hinge"/>
        <joint axis="1 0 0" name="right_hip_x" pos="0 0 0" range="-30 30" type="hinge"/>
        <joint axis="0 0 1" name="right_hip_z" pos="0 0 0" range="-30 30" type="hinge"/>
        <geom name="right_thigh_geom" pos="0 0 -0.2" size="0.06 0.2" type="capsule"/>

        <body name="right_shin" pos="0 0 -0.4">
          <joint axis="0 1 0" name="right_knee" pos="0 0 0" range="-120 0" type="hinge"/>
          <geom name="right_shin_geom" pos="0 0 -0.2" size="0.05 0.2" type="capsule"/>

          <body name="right_foot" pos="0 0 -0.4">
            <joint axis="0 1 0" name="right_ankle" pos="0 0 0" range="-45 45" type="hinge"/>
            <geom name="right_foot_geom" pos="0 0.05 0" size="0.08 0.04" type="capsule"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.1 0">
        <joint axis="0 1 0" name="left_hip_y" pos="0 0 0" range="-120 120" type="hinge"/>
        <joint axis="1 0 0" name="left_hip_x" pos="0 0 0" range="-30 30" type="hinge"/>
        <joint axis="0 0 1" name="left_hip_z" pos="0 0 0" range="-30 30" type="hinge"/>
        <geom name="left_thigh_geom" pos="0 0 -0.2" size="0.06 0.2" type="capsule"/>

        <body name="left_shin" pos="0 0 -0.4">
          <joint axis="0 1 0" name="left_knee" pos="0 0 0" range="-120 0" type="hinge"/>
          <geom name="left_shin_geom" pos="0 0 -0.2" size="0.05 0.2" type="capsule"/>

          <body name="left_foot" pos="0 0 -0.4">
            <joint axis="0 1 0" name="left_ankle" pos="0 0 0" range="-45 45" type="hinge"/>
            <geom name="left_foot_geom" pos="0 -0.05 0" size="0.08 0.04" type="capsule"/>
          </body>
        </body>
      </body>

      <body name="right_shoulder" pos="0.15 -0.15 0.15">
        <joint axis="0 1 0" name="right_shoulder_y" pos="0 0 0" range="-120 120" type="hinge"/>
        <joint axis="1 0 0" name="right_shoulder_x" pos="0 0 0" range="-120 120" type="hinge"/>
        <geom name="right_shoulder_geom" pos="0 0 0" size="0.04" type="sphere"/>

        <body name="right_arm" pos="0 0 -0.2">
          <joint axis="0 1 0" name="right_elbow" pos="0 0 0" range="-120 0" type="hinge"/>
          <geom name="right_arm_geom" pos="0 0 -0.15" size="0.04 0.15" type="capsule"/>

          <body name="right_hand" pos="0 0 -0.3">
            <geom name="right_hand_geom" pos="0 0 0" size="0.04" type="sphere"/>
          </body>
        </body>
      </body>

      <body name="left_shoulder" pos="-0.15 -0.15 0.15">
        <joint axis="0 1 0" name="left_shoulder_y" pos="0 0 0" range="-120 120" type="hinge"/>
        <joint axis="1 0 0" name="left_shoulder_x" pos="0 0 0" range="-120 120" type="hinge"/>
        <geom name="left_shoulder_geom" pos="0 0 0" size="0.04" type="sphere"/>

        <body name="left_arm" pos="0 0 -0.2">
          <joint axis="0 1 0" name="left_elbow" pos="0 0 0" range="-120 0" type="hinge"/>
          <geom name="left_arm_geom" pos="0 0 -0.15" size="0.04 0.15" type="capsule"/>

          <body name="left_hand" pos="0 0 -0.3">
            <geom name="left_hand_geom" pos="0 0 0" size="0.04" type="sphere"/>
          </body>
        </body>
      </body>

      <body name="head" pos="0 0 0.3">
        <joint axis="0 1 0" name="neck" pos="0 0 0" range="-45 45" type="hinge"/>
        <geom name="head_geom" pos="0 0 0.08" size="0.09" type="sphere"/>
        <geom name="neck_geom" pos="0 0 0" size="0.04 0.08" type="capsule"/>
      </body>
    </body>
  </worldbody>
</mujoco>
